# PiAgent configuration
# Copy to .env and fill in real values. Never commit .env.

# Pi identity
PI_AGENT_NAME=PiAgent
PI_HOST=127.0.0.1
PI_PORT=8000

# Security
# Set to the lowercase SHA-256 digest of a random token with at least 32 characters.
AGENT_TOKEN_HASH=

# Voice
WAKE_WORDS=hey pi,hello pi
# Set to an already-downloaded faster-whisper model directory to enable Pi STT.
WHISPER_MODEL_PATH=
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VOICE_VAD_THRESHOLD=400
PIPER_VOICE=en_US-lessac-medium

# Local LLM
USE_OLLAMA=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SECONDS=12
LLM_MAX_TOKENS=180

# Agent behavior
DEFAULT_MODE=permission
AUTO_MODE_ENABLED=false
HEARTBEAT_INTERVAL_SECONDS=10
WEBSOCKET_RECONNECT_MAX_SECONDS=30

# Notification apps
NOTIFICATION_APPS=com.whatsapp,org.telegram.messenger,com.google.android.apps.messaging

# Optional ADB
ADB_ENABLED=false